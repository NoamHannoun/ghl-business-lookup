# ─── GoHighLevel ─────────────────────────────────────────────
# Settings → API Keys → Location API Key
GHL_API_KEY=your_ghl_location_api_key_here

# Custom Field IDs for "Owner Info" field group
# Settings → Custom Fields → click field → ID is shown in the list
GHL_FIELD_OWNER_FIRST=your_field_id_here
GHL_FIELD_OWNER_LAST=your_field_id_here
GHL_FIELD_OWNER_ADDRESS=your_field_id_here
GHL_FIELD_OWNER_CITY=your_field_id_here
GHL_FIELD_OWNER_STATE=your_field_id_here
GHL_FIELD_OWNER_ZIP=your_field_id_here

# ─── OpenCorporates ───────────────────────────────────────────
# Get free trial token at: https://opencorporates.com/api_docs
OC_API_TOKEN=your_opencorporates_token_here
